PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/gfis

# Intro extraction provider: openai | gemini | claude | auto
INTRO_EXTRACTION_PROVIDER=gemini

# Gemini setup
GEMINI_API_KEY=
